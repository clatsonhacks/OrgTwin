# ---- Public address -------------------------------------------------------
# ":80" = http://<VM IP>   |   "orgtwin.yourdomain.com" = automatic HTTPS
SITE_ADDRESS=:80
PUBLIC_APP_URL=http://YOUR_VM_IP
POSTGRES_PASSWORD=change-me
# Optional: require this token (X-Access-Token) for anything that changes data
APP_ACCESS_TOKEN=

# ---- Vultr Serverless Inference (OpenAI-compatible) ----------------------
# Subscription API key (Console → Serverless → Inference → your subscription), NOT the account API key
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Leave empty to use the first model from /models; set one from the live model list to pin it
VULTR_INFERENCE_MODEL=
# Skill Recorder: vision model that reads screenshots. Empty = auto-pick a vision-capable model
# from the live model list (ids containing vl / vision / llava / pixtral ...); none = narration only.
VULTR_VISION_MODEL=
# "none" turns off model thinking (reasoning models otherwise use up max_tokens); empty = omit
VULTR_REASONING_EFFORT=none

# ---- One-click "Connect" popups (set once by the admin) -------------------
# With these set, users connect Google Sheets, Gmail and Stripe from the app: they click Connect,
# sign in, click Allow. Nothing else to copy. See docs/connectors.md → "One-click sign-in".
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <PUBLIC_API_URL>/api/oauth/google/callback
# Enable the Google Sheets API and the Gmail API in the same project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Stripe Dashboard (test mode) → Settings → Connect → OAuth: client id ca_… and the platform's sk_test_ key.
# Redirect URI: <PUBLIC_API_URL>/api/oauth/stripe/callback
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_SECRET_KEY=
# Where the browser reaches the API. Empty = PUBLIC_APP_URL (Caddy serves /api on the same origin).
# Local dev: http://localhost:8000
PUBLIC_API_URL=

# ---- Connectors (optional here: users can connect them in the app instead) -
# Google Sheets CRM: share the sheet with the service account's email
GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/google-sa.json
GOOGLE_SHEET_ID=
# Email over SMTP (Gmail: smtp.gmail.com + an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Safety: every demo email goes to this inbox instead of the lead's address
EMAIL_REDIRECT_TO=
# Stripe TEST key only (sk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=
# Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# Discord: channel → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
# Microsoft Teams: channel → Workflows → "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=
# Telegram: bot token from @BotFather + the chat id the bot is in
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notion: internal integration token + a database shared with it
NOTION_TOKEN=
NOTION_DATABASE_ID=
# HubSpot: private app token with crm.objects.contacts.read/write
HUBSPOT_TOKEN=
# Generic webhook step (Zapier, Make, n8n, your API). Off = demo mode.
# Calls to private/internal addresses are always refused; optionally allow only these hosts.
WEBHOOK_ENABLED=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_HTTP=false

# Web search step. Works without a key (DuckDuckGo instant answers + Wikipedia).
# For full web results add one of these (tavily.com / brave.com/search/api).
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- Sandbox -------------------------------------------------------------
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_S=20
SANDBOX_MEMORY=128m
STEP_DELAY_S=1.2
